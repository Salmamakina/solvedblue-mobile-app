# Backend API. No trailing slash and no /api suffix: the client appends /api.
# Use a LAN IP for a physical device; localhost resolves to the phone itself.
EXPO_PUBLIC_API_URL=http://192.168.1.117:3000

# Google OAuth client ids. Create one per platform in the Firebase console
# (Project settings > General > Your apps) or Google Cloud Console > Credentials:
#   Web      - also used by Expo Go and the browser
#   iOS      - bundle id com.spyder.mobile
#   Android  - package com.spyder.mobile, plus the signing SHA-1
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Firebase client config, from the same project. Used only to exchange the
# Google token for a Firebase ID token, which is what the backend verifies.
# Must be the project the backend's FIREBASE_PROJECT_ID points at, or the
# token's audience will not match.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
