# Backend API. No trailing slash, no /api suffix: the client appends /api itself.
# Device testing note: localhost points at the phone, not your machine.
# Use your LAN IP (the backend's CORS already allows 192.168.x.x / 10.x.x.x).
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Firebase web config: the same project the web app uses, so sign-in matches.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
