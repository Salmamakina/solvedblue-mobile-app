# Backend API. No trailing slash and no /api suffix: the client appends /api.
# Use a LAN IP for a physical device; localhost resolves to the phone itself.
EXPO_PUBLIC_API_URL=http://192.168.1.117:3000

# Google OAuth client IDs, from the Firebase console (the offa-spyder project)
# or Google Cloud Console > Credentials. The backend turns the resulting
# id_token into its own JWT on /auth/firebase, the same endpoint the web app uses.
#
# Create one client id per platform:
#   Web       - also used by Expo Go and the browser
#   iOS       - bundle id com.spyder.mobile
#   Android   - package com.spyder.mobile, plus the signing SHA-1
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
